{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "tasks": {
    //Building
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"],
      "cache": true
    },
    //Running
    "run:local": {
      "cache": false,
      "persistent": true
    },
    //Checking
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check:types": {
      "dependsOn": ["transit"]
    },
    "check:lint": {
      "dependsOn": ["transit"]
    },
    "//#transit": {
      "dependsOn": ["^//#transit"]
    },
    "//#check:dedupe": {
      // Fails when the lockfile holds duplicate versions that `pnpm dedupe` would collapse; only manifests and the lockfile matter.
      "inputs": ["pnpm-lock.yaml", "pnpm-workspace.yaml", "package.json", "**/package.json"]
    },
    //Testing
    "test:unit": {
      "dependsOn": ["transit"],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "cache": true
    }
  }
}
