{
  "name": "@repo/tooling-typescript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "src/*.json"
  ],
  "exports": {
    "./base": "./src/base.json",
    "./backend": "./src/backend.json",
    "./frontend": "./src/frontend.json",
    "./frontend-next": "./src/frontend-next.json",
    "./frontend-lib": "./src/frontend-lib.json",
    "./internal-package": "./src/internal-package.json"
  },
  "scripts": {
    "check:lint": "biome check --write --unsafe --max-diagnostics=none .",
    "check:types": "tsc --noEmit -p tests",
    "test:unit": "vitest run --project unit"
  },
  "devDependencies": {
    "@repo/tooling-vitest": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
